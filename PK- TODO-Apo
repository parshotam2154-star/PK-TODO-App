import os

PASSWORD = "1234"
FILE_NAME = "tasks.txt"

# Password Check
user_pass = input("PK TODO me Welcome! Password likhein: ")
if user_pass != PASSWORD:
    print("Ghalat Password!")
    exit()

print("\n--- PK TODO App Started ---\n")

# Tasks load karna
tasks = []
if os.path.exists(FILE_NAME):
    with open(FILE_NAME, "r") as f:
        tasks = f.read().splitlines()

while True:
    print("\n1. Task Dekhein")
    print("2. Naya Task Add Karein")
    print("3. Task Delete Karein")
    print("4. Exit")
    
    choice = input("Aapka Choice (1-4): ")
    
    if choice == "1":
        if not tasks:
            print("Koi Task nahi hai!")
        else:
            print("\n--- Aapke Tasks ---")
            for i, task in enumerate(tasks, 1):
                print(f"{i}. {task}")
    
    elif choice == "2":
        new_task = input("Naya Task likhein (jaise: Work - Website banana): ")
        tasks.append(new_task)
        with open(FILE_NAME, "w") as f:
            for t in tasks:
                f.write(t + "\n")
        print("Task Save ho gaya!")
        
    elif choice == "3":
        num = int(input("Kaunsa number delete karna hai? "))
        if 1 <= num <= len(tasks):
            tasks.pop(num-1)
            with open(FILE_NAME, "w") as f:
                for t in tasks:
                    f.write(t + "\n")
            print("Delete ho gaya!")
        else:
            print("Ghalat Number!")
            
    elif choice == "4":
        print("Shukriya! PK TODO band ho raha hai.")
        break
    else:
        print("Ghalat choice, 1-4 likhein!")